# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/npc_memory_engine
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=password
PG_DATABASE=npc_memory_engine

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=npc_memories

# JWT
JWT_SECRET=change-this-to-a-random-secret-key-eval-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Google Gemini LLM (optional - contextual mock fallback available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_PROVIDER=mock

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_CHAT=60/minute
